client
dev tun
proto udp
tun-mtu 1400
cipher BF-CBC
comp-lzo yes
compress stub-v2 lz4-v2
remote 58.56.125.18 1194
resolv-retry infinite
nobind
persist-key
persist-tun
verb 3
auth-user-pass /soft/gatewayclient/cmake-build-debug/tools/openvpn/login.conf
client-cert-not-required
script-security 2
